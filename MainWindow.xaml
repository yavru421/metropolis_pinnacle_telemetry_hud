<Window x:Class="MetropolisHUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="METROPOLIS PINNACLE TELEMETRY HUD" Height="400" Width="720"
        Topmost="True" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Background="#11111B" Loaded="Window_Loaded" Closing="Window_Closing">
    
    <Window.Resources>
        <Style x:Key="FilterBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#11111B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- LED Matrix -->
            <RowDefinition Height="Auto"/> <!-- Filter & Search Toolbar -->
            <RowDefinition Height="*"/>    <!-- Rich Terminal Output -->
            <RowDefinition Height="Auto"/> <!-- Footer Ticker & Sparkline -->
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#181825" Padding="10,8" BorderBrush="#313244" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="#CBA6F7" Margin="0,0,8,0"/>
                    <TextBlock Text="METROPOLIS PINNACLE TELEMETRY HUD" Foreground="#CDD6F4" FontWeight="Bold" FontSize="13" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <Border x:Name="BadgeClickThrough" Background="#313244" CornerRadius="3" Padding="4,1" Margin="10,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="CLICK-THROUGH (WIN+H)" Foreground="#F9E2AF" FontSize="8.5" FontFamily="Consolas" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="SNAP ↗" x:Name="BtnSnapTR" Click="BtnSnapTR_Click" Background="#313244" Foreground="#CDD6F4" FontSize="9" FontFamily="Consolas" Margin="2,0" Padding="4,2" BorderThickness="0"/>
                    <Button Content="SNAP ↘" x:Name="BtnSnapBR" Click="BtnSnapBR_Click" Background="#313244" Foreground="#CDD6F4" FontSize="9" FontFamily="Consolas" Margin="2,0" Padding="4,2" BorderThickness="0"/>
                    <Button Content="SNAP ↖" x:Name="BtnSnapTL" Click="BtnSnapTL_Click" Background="#313244" Foreground="#CDD6F4" FontSize="9" FontFamily="Consolas" Margin="2,0" Padding="4,2" BorderThickness="0"/>
                    <TextBlock Text="9-CHANNEL TELEMETRY ENGINE" Foreground="#A6ADC8" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 9-LED Matrix -->
        <UniformGrid Grid.Row="1" Columns="9" Margin="8,6,8,2">
            <!-- 1. THOUGHT LED -->
            <Border Background="#181825" CornerRadius="6" Padding="4" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedThought" Width="14" Height="14" Fill="#45475A" Margin="0,0,0,3"/>
                    <TextBlock Text="THOUGHT" Foreground="#CBA6F7" FontSize="8" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 2. DUCKDB LED -->
            <Border Background="#181825" CornerRadius="6" Padding="4" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedDuckDb" Width="14" Height="14" Fill="#45475A" Margin="0,0,0,3"/>
                    <TextBlock Text="DUCKDB" Foreground="#A6E3A1" FontSize="8" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 3. EDGE LED -->
            <Border Background="#181825" CornerRadius="6" Padding="4" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedEdge" Width="14" Height="14" Fill="#45475A" Margin="0,0,0,3"/>
                    <TextBlock Text="EDGE" Foreground="#89B4FA" FontSize="8" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 4. MCP LED -->
            <Border Background="#181825" CornerRadius="6" Padding="4" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedMcp" Width="14" Height="14" Fill="#45475A" Margin="0,0,0,3"/>
                    <TextBlock Text="MCP" Foreground="#FAB387" FontSize="8" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 5. SKILLS LED -->
            <Border Background="#181825" CornerRadius="6" Padding="4" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedSkills" Width="14" Height="14" Fill="#45475A" Margin="0,0,0,3"/>
                    <TextBlock Text="SKILLS" Foreground="#F5C2E7" FontSize="8" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 6. MUTATE LED -->
            <Border Background="#181825" CornerRadius="6" Padding="4" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedMutate" Width="14" Height="14" Fill="#45475A" Margin="0,0,0,3"/>
                    <TextBlock Text="MUTATE" Foreground="#F9E2AF" FontSize="8" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 7. AGENT LED -->
            <Border Background="#181825" CornerRadius="6" Padding="4" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedAgent" Width="14" Height="14" Fill="#45475A" Margin="0,0,0,3"/>
                    <TextBlock Text="AGENT" Foreground="#E78284" FontSize="8" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 8. SEARCH LED -->
            <Border Background="#181825" CornerRadius="6" Padding="4" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedSearch" Width="14" Height="14" Fill="#45475A" Margin="0,0,0,3"/>
                    <TextBlock Text="SEARCH" Foreground="#94E2D5" FontSize="8" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 9. ERROR LED -->
            <Border Background="#181825" CornerRadius="6" Padding="4" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedError" Width="14" Height="14" Fill="#45475A" Margin="0,0,0,3"/>
                    <TextBlock Text="ERROR" Foreground="#F38BA8" FontSize="8" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filter & Search Toolbar (Item 3) -->
        <Border Grid.Row="2" Background="#181825" Padding="6,4" Margin="8,2" CornerRadius="4" BorderBrush="#313244" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" x:Name="FilterPanel">
                        <Button Content="ALL" Tag="ALL" Click="FilterButton_Click" Style="{StaticResource FilterBtnStyle}" Margin="2,0"/>
                        <Button Content="THOUGHT" Tag="THOUGHT" Click="FilterButton_Click" Style="{StaticResource FilterBtnStyle}" Margin="2,0"/>
                        <Button Content="DUCKDB" Tag="DUCKDB" Click="FilterButton_Click" Style="{StaticResource FilterBtnStyle}" Margin="2,0"/>
                        <Button Content="EDGE" Tag="EDGE" Click="FilterButton_Click" Style="{StaticResource FilterBtnStyle}" Margin="2,0"/>
                        <Button Content="MCP" Tag="MCP" Click="FilterButton_Click" Style="{StaticResource FilterBtnStyle}" Margin="2,0"/>
                        <Button Content="SKILLS" Tag="SKILLS" Click="FilterButton_Click" Style="{StaticResource FilterBtnStyle}" Margin="2,0"/>
                        <Button Content="MUTATE" Tag="MUTATE" Click="FilterButton_Click" Style="{StaticResource FilterBtnStyle}" Margin="2,0"/>
                        <Button Content="AGENT" Tag="AGENT" Click="FilterButton_Click" Style="{StaticResource FilterBtnStyle}" Margin="2,0"/>
                        <Button Content="SEARCH" Tag="SEARCH" Click="FilterButton_Click" Style="{StaticResource FilterBtnStyle}" Margin="2,0"/>
                        <Button Content="ERROR" Tag="ERROR" Click="FilterButton_Click" Style="{StaticResource FilterBtnStyle}" Margin="2,0"/>
                    </StackPanel>
                </ScrollViewer>
                <TextBox Grid.Column="1" x:Name="TxtSearch" Width="140" Margin="8,0,4,0" Padding="4,2" Background="#11111B" Foreground="#CDD6F4" BorderBrush="#45475A" FontSize="9.5" FontFamily="Consolas" TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center" ToolTip="Filter log entries..."/>
                <Button Grid.Column="2" Content="⚡ SELF-TEST" Click="BtnSelfTest_Click" Background="#313244" Foreground="#F9E2AF" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Padding="6,2" Margin="2,0" VerticalAlignment="Center" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Rich Terminal Output (Item 4) -->
        <Border Grid.Row="3" Background="#181825" CornerRadius="6" Padding="6" Margin="8,2" BorderBrush="#313244" BorderThickness="1">
            <RichTextBox x:Name="RichLog" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#CDD6F4" FontSize="11" FontFamily="Consolas" VerticalScrollBarVisibility="Auto">
                <FlowDocument x:Name="DocLog" PagePadding="0"/>
            </RichTextBox>
        </Border>

        <!-- Footer System Bar with Sparkline Pulse Meter (Item 5) -->
        <Border Grid.Row="4" Background="#181825" Padding="6,4" Margin="8,2,8,8" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtThoughtTrace" Text="THOUGHT TRACE: Listening on \\.\pipe\MetropolisHUDPipe &amp; hud_signal.json..." Foreground="#CBA6F7" FontSize="9.5" FontFamily="Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                
                <!-- Sparkline Canvas -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="PULSE:" Foreground="#6C7086" FontSize="8.5" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Canvas x:Name="SparklineCanvas" Width="80" Height="18" Background="#11111B" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2" x:Name="TxtEpm" Text="0 EPM" Foreground="#89B4FA" FontSize="9.5" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <TextBlock Grid.Column="3" x:Name="TxtCounter" Text="EVENTS: 0" Foreground="#A6ADC8" FontSize="9.5" FontFamily="Consolas" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
