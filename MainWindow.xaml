<Window x:Class="MetropolisHUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="METROPOLIS PINNACLE TELEMETRY HUD" Height="300" Width="680"
        Topmost="True" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
    <Grid Background="#11111B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#181825" Padding="10" BorderBrush="#313244" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Fill="#CBA6F7" Margin="0,0,8,0"/>
                    <TextBlock Text="METROPOLIS PINNACLE TELEMETRY HUD" Foreground="#CDD6F4" FontWeight="Bold" FontSize="13" FontFamily="Consolas"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="9-CHANNEL TELEMETRY ENGINE" Foreground="#A6ADC8" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 9-LED Matrix -->
        <UniformGrid Grid.Row="1" Columns="9" Margin="8">
            <!-- 1. THOUGHT LED -->
            <Border Background="#181825" CornerRadius="6" Padding="6" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedThought" Width="16" Height="16" Fill="#45475A" Margin="0,0,0,4"/>
                    <TextBlock Text="THOUGHT" Foreground="#CBA6F7" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 2. DUCKDB LED -->
            <Border Background="#181825" CornerRadius="6" Padding="6" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedDuckDb" Width="16" Height="16" Fill="#45475A" Margin="0,0,0,4"/>
                    <TextBlock Text="DUCKDB" Foreground="#A6E3A1" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 3. EDGE LED -->
            <Border Background="#181825" CornerRadius="6" Padding="6" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedEdge" Width="16" Height="16" Fill="#45475A" Margin="0,0,0,4"/>
                    <TextBlock Text="EDGE" Foreground="#89B4FA" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 4. MCP LED -->
            <Border Background="#181825" CornerRadius="6" Padding="6" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedMcp" Width="16" Height="16" Fill="#45475A" Margin="0,0,0,4"/>
                    <TextBlock Text="MCP" Foreground="#FAB387" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 5. SKILLS LED -->
            <Border Background="#181825" CornerRadius="6" Padding="6" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedSkills" Width="16" Height="16" Fill="#45475A" Margin="0,0,0,4"/>
                    <TextBlock Text="SKILLS" Foreground="#F5C2E7" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 6. MUTATE LED -->
            <Border Background="#181825" CornerRadius="6" Padding="6" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedMutate" Width="16" Height="16" Fill="#45475A" Margin="0,0,0,4"/>
                    <TextBlock Text="MUTATE" Foreground="#F9E2AF" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 7. AGENT LED -->
            <Border Background="#181825" CornerRadius="6" Padding="6" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedAgent" Width="16" Height="16" Fill="#45475A" Margin="0,0,0,4"/>
                    <TextBlock Text="AGENT" Foreground="#E78284" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 8. SEARCH LED -->
            <Border Background="#181825" CornerRadius="6" Padding="6" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedSearch" Width="16" Height="16" Fill="#45475A" Margin="0,0,0,4"/>
                    <TextBlock Text="SEARCH" Foreground="#94E2D5" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 9. ERROR LED -->
            <Border Background="#181825" CornerRadius="6" Padding="6" Margin="2" BorderBrush="#313244" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse x:Name="LedError" Width="16" Height="16" Fill="#45475A" Margin="0,0,0,4"/>
                    <TextBlock Text="ERROR" Foreground="#F38BA8" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main Ticker & Thought Stream Box -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="6" Padding="10" Margin="8,0,8,4" BorderBrush="#313244" BorderThickness="1">
            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtLog" Text="[SYS: PINNACLE HUD ONLINE] Listening for sequentialthinking, MCP, edge, and DuckDB signals..." Foreground="#A6E3A1" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- Footer System Bar -->
        <Border Grid.Row="3" Background="#181825" Padding="6,4" Margin="8,0,8,8" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtThoughtTrace" Text="THOUGHT TRACE: Idle..." Foreground="#CBA6F7" FontSize="9.5" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" x:Name="TxtCounter" Text="EVENTS: 0" Foreground="#A6ADC8" FontSize="9.5" FontFamily="Consolas"/>
            </Grid>
        </Border>
    </Grid>
</Window>
