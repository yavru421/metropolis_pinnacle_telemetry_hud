<Window x:Class="MetropolisHUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="METROPOLIS TELEMETRY HUD" Height="480" Width="960"
        Topmost="True" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" WindowStyle="None"
        Background="#18050914" Loaded="Window_Loaded" Closing="Window_Closing">
    
    <Border Background="#20050B1A" BorderBrush="#301E293B" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Settings & Control Bar -->
                <RowDefinition Height="Auto"/> <!-- Stealth Indicator Matrix -->
                <RowDefinition Height="*"/>    <!-- Terminal Log Stream -->
                <RowDefinition Height="Auto"/> <!-- Active User Activity Bar -->
            </Grid.RowDefinitions>

            <!-- Top Controls & Action Bar -->
            <Border Grid.Row="0" Background="#300F172A" Padding="14,8" BorderBrush="#201E293B" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="METROPOLIS HUD" Foreground="#94A3B8" FontWeight="Black" FontSize="11" FontFamily="Consolas" Margin="0,0,14,0"/>
                        <Border x:Name="BadgeClickThrough" Background="#40334155" CornerRadius="4" Padding="6,2" Visibility="Collapsed" BorderBrush="#00F3FF" BorderThickness="1">
                            <TextBlock Text="PASS-THROUGH (WIN+H)" Foreground="#00F3FF" FontSize="8.5" FontFamily="Consolas" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BtnToggleLogs" Content="▼ COLLAPSE LOGS" Background="#20334155" Foreground="#00F3FF" BorderBrush="#334155" BorderThickness="1" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Padding="10,3" Click="BtnToggleLogs_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⚙ SETTINGS" Background="#20334155" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Padding="8,3" Margin="0,0,6,0" Click="BtnOpenSettingsWindow_Click"/>
                        <Button Content="✕" Background="#30EF4444" Foreground="#EF4444" BorderBrush="#EF4444" BorderThickness="1" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Padding="6,2" ToolTip="Exit HUD" Click="BtnCloseApp_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Channel Matrix Bar (Large Glow Badges, Invisible when idle) -->
            <Border Grid.Row="1" Background="#200A0E17" Padding="14,12" BorderBrush="#201E293B" BorderThickness="0,0,0,1">
                <UniformGrid Columns="11" HorizontalAlignment="Center">
                    <!-- THOUGHT -->
                    <Border x:Name="BadgeThought" Opacity="0" Background="#C01E142B" BorderBrush="#C084FC" BorderThickness="2" CornerRadius="8" Padding="10,8" Margin="3,0" ToolTip="THOUGHT">
                        <Border.Effect>
                            <DropShadowEffect Color="#C084FC" BlurRadius="16" ShadowDepth="0" Opacity="1.0"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtThought" Text="THOUGHT" Foreground="#F3E8FF" FontSize="20" FontFamily="Consolas" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- SEQTHINK -->
                    <Border x:Name="BadgeSeqthink" Opacity="0" Background="#C014182B" BorderBrush="#818CF8" BorderThickness="2" CornerRadius="8" Padding="10,8" Margin="3,0" ToolTip="SEQTHINK">
                        <Border.Effect>
                            <DropShadowEffect Color="#818CF8" BlurRadius="16" ShadowDepth="0" Opacity="1.0"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtSeqthink" Text="SEQTHINK" Foreground="#E0E7FF" FontSize="20" FontFamily="Consolas" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- DUCKDB -->
                    <Border x:Name="BadgeDuckDb" Opacity="0" Background="#C00E2319" BorderBrush="#4ADE80" BorderThickness="2" CornerRadius="8" Padding="10,8" Margin="3,0" ToolTip="DUCKDB">
                        <Border.Effect>
                            <DropShadowEffect Color="#4ADE80" BlurRadius="16" ShadowDepth="0" Opacity="1.0"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtDuckDb" Text="DUCKDB" Foreground="#DCFCE7" FontSize="20" FontFamily="Consolas" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- EDGE -->
                    <Border x:Name="BadgeEdge" Opacity="0" Background="#C00C202B" BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="8" Padding="10,8" Margin="3,0" ToolTip="EDGE">
                        <Border.Effect>
                            <DropShadowEffect Color="#38BDF8" BlurRadius="16" ShadowDepth="0" Opacity="1.0"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtEdge" Text="EDGE" Foreground="#E0F2FE" FontSize="20" FontFamily="Consolas" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- WRANGLER -->
                    <Border x:Name="BadgeWrangler" Opacity="0" Background="#C026210D" BorderBrush="#FACC15" BorderThickness="2" CornerRadius="8" Padding="10,8" Margin="3,0" ToolTip="WRANGLER">
                        <Border.Effect>
                            <DropShadowEffect Color="#FACC15" BlurRadius="16" ShadowDepth="0" Opacity="1.0"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtWrangler" Text="WRANGLER" Foreground="#FEF9C3" FontSize="20" FontFamily="Consolas" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- MCP -->
                    <Border x:Name="BadgeMcp" Opacity="0" Background="#C029190F" BorderBrush="#FB923C" BorderThickness="2" CornerRadius="8" Padding="10,8" Margin="3,0" ToolTip="MCP">
                        <Border.Effect>
                            <DropShadowEffect Color="#FB923C" BlurRadius="16" ShadowDepth="0" Opacity="1.0"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtMcp" Text="MCP" Foreground="#FFEDD5" FontSize="20" FontFamily="Consolas" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- SKILLS -->
                    <Border x:Name="BadgeSkills" Opacity="0" Background="#C0281423" BorderBrush="#F472B6" BorderThickness="2" CornerRadius="8" Padding="10,8" Margin="3,0" ToolTip="SKILLS">
                        <Border.Effect>
                            <DropShadowEffect Color="#F472B6" BlurRadius="16" ShadowDepth="0" Opacity="1.0"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtSkills" Text="SKILLS" Foreground="#FCE7F3" FontSize="20" FontFamily="Consolas" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- MUTATE -->
                    <Border x:Name="BadgeMutate" Opacity="0" Background="#C02B1416" BorderBrush="#F87171" BorderThickness="2" CornerRadius="8" Padding="10,8" Margin="3,0" ToolTip="MUTATE">
                        <Border.Effect>
                            <DropShadowEffect Color="#F87171" BlurRadius="16" ShadowDepth="0" Opacity="1.0"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtMutate" Text="MUTATE" Foreground="#FEE2E2" FontSize="20" FontFamily="Consolas" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- AGENT -->
                    <Border x:Name="BadgeAgent" Opacity="0" Background="#C02B1419" BorderBrush="#FB7185" BorderThickness="2" CornerRadius="8" Padding="10,8" Margin="3,0" ToolTip="AGENT">
                        <Border.Effect>
                            <DropShadowEffect Color="#FB7185" BlurRadius="16" ShadowDepth="0" Opacity="1.0"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtAgent" Text="AGENT" Foreground="#FFE4E6" FontSize="20" FontFamily="Consolas" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- SEARCH -->
                    <Border x:Name="BadgeSearch" Opacity="0" Background="#C00C2524" BorderBrush="#2DD4BF" BorderThickness="2" CornerRadius="8" Padding="10,8" Margin="3,0" ToolTip="SEARCH">
                        <Border.Effect>
                            <DropShadowEffect Color="#2DD4BF" BlurRadius="16" ShadowDepth="0" Opacity="1.0"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtSearch" Text="SEARCH" Foreground="#CCFBF1" FontSize="20" FontFamily="Consolas" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- ERROR -->
                    <Border x:Name="BadgeError" Opacity="0" Background="#C02B0F13" BorderBrush="#EF4444" BorderThickness="2" CornerRadius="8" Padding="10,8" Margin="3,0" ToolTip="ERROR">
                        <Border.Effect>
                            <DropShadowEffect Color="#EF4444" BlurRadius="20" ShadowDepth="0" Opacity="1.0"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtError" Text="ERROR" Foreground="#FEE2E2" FontSize="20" FontFamily="Consolas" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Border>
                </UniformGrid>
            </Border>

            <!-- Ultra-Clean Log Stream -->
            <Border Grid.Row="2" x:Name="BorderLogContainer" Background="Transparent" Padding="14,10">
                <RichTextBox x:Name="RichLog" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#F1F5F9" FontSize="11" FontFamily="Consolas" VerticalScrollBarVisibility="Auto">
                    <FlowDocument x:Name="DocLog" PagePadding="0"/>
                </RichTextBox>
            </Border>

            <!-- Active User & Process Task Bar -->
            <Border Grid.Row="3" Background="#400A0E17" Padding="14,8" BorderBrush="#201E293B" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#00F3FF" CornerRadius="4" Width="8" Height="8" Margin="0,0,8,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#00F3FF" BlurRadius="6" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="USER TASK:" Foreground="#00F3FF" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" x:Name="TxtThoughtTrace" Text="ACTIVE: Monitoring system execution &amp; background tasks..." Foreground="#CBD5E1" FontSize="9.5" FontFamily="Consolas" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="PULSE:" Foreground="#64748B" FontSize="8.5" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Canvas x:Name="SparklineCanvas" Width="64" Height="12" Background="Transparent" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCounter" Text="EVENTS: 0" Foreground="#38BDF8" FontSize="9" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
